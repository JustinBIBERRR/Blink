{
  "productName": "Blink",
  "version": "0.1.0",
  "identifier": "dev.blink-rs.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "stats",
        "url": "index.html#/stats",
        "visible": false,
        "decorations": false,
        "transparent": false,
        "width": 380,
        "height": 560,
        "resizable": false,
        "center": true
      },
      {
        "label": "settings",
        "url": "index.html#/settings",
        "visible": false,
        "decorations": false,
        "transparent": false,
        "width": 760,
        "height": 700,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
