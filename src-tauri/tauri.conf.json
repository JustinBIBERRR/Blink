{
  "productName": "Blink",
  "version": "0.1.0",
  "identifier": "dev.blink-rs.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "url": "index.html#/overlay",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "resizable": false
      },
      {
        "label": "stats",
        "url": "index.html#/stats",
        "visible": false,
        "decorations": false,
        "transparent": false,
        "width": 380,
        "height": 560,
        "resizable": false,
        "center": true
      },
      {
        "label": "settings",
        "url": "index.html#/settings",
        "visible": false,
        "decorations": false,
        "transparent": false,
        "width": 340,
        "height": 490,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
